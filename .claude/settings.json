{
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm run *)",
      "Bash(pnpm audit*)",
      "Bash(pnpm dlx tsc*)",
      "Bash(pnpm dlx vite*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/.env*)",
      "Read(~/.gnupg/**)",
      "Write(~/.ssh/**)",
      "Write(~/.aws/**)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)",
      "Bash(rm -rf /*)",
      "Bash(git push --force *)"
    ]
  }
}
